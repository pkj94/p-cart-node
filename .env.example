# Copy to .env (git-ignored) and fill in. Real environment variables override this file.

# production: secure cookies, HSTS, quiet console, combined access log, static file caching
NODE_ENV=production
PORT=8000

# Database login. Any DB_* value here overrides config.json and admin/config.json
DB_USERNAME=
DB_PASSWORD=
# DB_HOSTNAME=localhost
# DB_DATABASE=
# DB_PORT=3306

# Signs the session cookie. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, a secret is generated once into system/storage/session_secret
SESSION_SECRET=

# Optional
# CORS_ORIGINS=https://app.example.com     comma-separated origins allowed to call the store from the browser
# ALLOW_INSTALL=1                           re-enable /install after installation
# DEBUG=1                                   keep console.log output in production
# BODY_LIMIT=5mb                            max form/JSON body size
# UPLOAD_MAX_MB=16                          max size of each uploaded file
# RATE_LIMIT_AUTH=20                        login/register/password-reset posts per IP per 15 minutes
# RATE_LIMIT_API=300                        API requests per IP per minute
# WEB_CONCURRENCY=max                       PM2 cluster processes
